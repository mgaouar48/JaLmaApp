{
  "expo": {
    "name": "JaLmaApp",
    "slug": "JaLmaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "jalmaapp",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jalma.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      },
      "config": {
        "googleMapsApiKey": "AIzaSyA8NtMXb8BiwzmYyLmjByTyEVpfP1Z0x4g"
      }
    },
    "android": {
      "package": "com.jalma.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA8NtMXb8BiwzmYyLmjByTyEVpfP1Z0x4g"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Autoriser $(PRODUCT_NAME) à utiliser votre position en permanence pour le suivi des livraisons.",
          "locationAlwaysUsageDescription": "Cette application a besoin de votre position pour le suivi des livraisons en arrière-plan.",
          "locationWhenInUsePermission": "Autoriser $(PRODUCT_NAME) à utiliser votre position pour sélectionner des adresses et suivre la citerne.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe08e1b3-8dd5-48c7-8ace-9b59d045f7aa"
      }
    }
  }
}